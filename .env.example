# 0xARK — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to git.

# ── Solana RPC ──────────────────────────────────────────────────────────────
# Primary RPC endpoint used by the multiplayer server (state.js)
SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Secondary name used by server.js (keep in sync with SOLANA_RPC_URL)
SOLANA_RPC=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Network label sent in x402 payment headers ("mainnet-beta" or "devnet")
SOLANA_NETWORK=mainnet-beta

# ── Treasury Wallets ─────────────────────────────────────────────────────────
# Primary treasury — receives x402 micropayments; required outside development mode
TREASURY_PUBKEY=YOUR_TREASURY_WALLET_ADDRESS

# Operations sub-treasury (defaults to TREASURY_PUBKEY if unset)
OPS_TREASURY_PUBKEY=YOUR_OPS_WALLET_ADDRESS

# Prize pool vault (accumulates Season 1 prize pool; defaults to TREASURY_PUBKEY if unset)
PRIZE_POOL_PUBKEY=YOUR_PRIZE_POOL_WALLET_ADDRESS

# ── AI Agent ────────────────────────────────────────────────────────────────
# Anthropic API key for AI strategy advisor and agent hire endpoints
ANTHROPIC_API_KEY=sk-ant-...

# Wallet that signs x402 payments on behalf of the AI broker
BROKER_WALLET=YOUR_BROKER_WALLET_PRIVATE_KEY_BASE58

# ── Infrastructure ───────────────────────────────────────────────────────────
# Redis connection string for x402 replay protection (nonce/signature deduplication)
# Omit or leave blank to use in-memory store (resets on server restart — dev only)
REDIS_URL=redis://localhost:6379

# ── Development ──────────────────────────────────────────────────────────────
# Set to "development" to enable demo mode (payments skipped, treasury not required)
# Any other value (or unset) requires all treasury vars above to be present
NODE_ENV=development
