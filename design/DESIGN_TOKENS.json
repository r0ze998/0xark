{
  "$schema": "./DESIGN_TOKENS.schema",
  "version": "1.0.0",
  "brand": "0xARK",
  "notes": "GBA-era pixel art. No anti-aliasing, no smooth scaling, no radii. All positions/sizes are integer px. Use these tokens as constants in PixiJS Graphics/Sprite calls. Replace any hex literal in rendering code with a lookup here.",

  "palette": {
    "locked": {
      "ocean_shallow":  "#4880c8",
      "ocean_deep":     "#1c3868",
      "night_sky":      "#0c1a38",
      "sand_beach":     "#e8c878",
      "hull_wood":      "#805028",
      "hull_highlight": "#a07040",
      "hull_shadow":    "#5c3818",
      "sail_cream":     "#f8e8c0",
      "sparkle_cream":  "#ffffc8",
      "flag_red":       "#c82828",
      "gold_accent":    "#f0b828",
      "menu_blue":      "#3858a0",
      "menu_border":    "#ffd860",
      "text_dark":      "#181028",
      "text_light":     "#f8f8e8"
    },
    "npc_identity": {
      "vega_magenta":   "#e040a0",
      "vega_deep":      "#882060",
      "vega_pulse":     "#ff70b0",
      "mira_amber":     "#f0b828",
      "mira_deep":      "#a07018",
      "mira_pulse":     "#ffd860"
    },
    "derived_overworld": {
      "grass_mid":      "#58c068",
      "grass_dark":     "#287840",
      "grass_light":    "#7ad078",
      "roof_red":       "#d04030",
      "roof_shadow":    "#902818",
      "roof_highlight": "#e86050",
      "wall_light":     "#d8d0c0",
      "wall_shadow":    "#a0a090",
      "path_tan":       "#d8a868",
      "path_shadow":    "#805028",
      "roof_purple":    "#7040a0",
      "roof_barn":      "#c8a868",
      "roof_forest":    "#4ba048",
      "flower_pink":    "#ff70b0",
      "flower_yellow":  "#f8e060",
      "flower_white":   "#f8f8e8"
    },
    "derived_dungeon": {
      "dungeon_floor":      "#c89060",
      "dungeon_wall":       "#482818",
      "dungeon_fog":        "#100818",
      "dungeon_quiet":      "#0c0818",
      "rival_pulse":        "#ff70b0",
      "vfx_crystal_orb":    "#48b8e8",
      "vfx_crystal_pale":   "#a0e0ff",
      "vfx_crystal_bolt":   "#64c8ff",
      "vfx_crystal_bolt2":  "#c8f0ff",
      "vfx_shadow_dark":    "#501e78",
      "vfx_shadow_mid":     "#8c50b4",
      "vfx_flame_core":     "#dc5028",
      "vfx_flame_tip":      "#ffc83c",
      "vfx_danger_flash":   "#ff2020",
      "vfx_void_dark":      "#6432a0",
      "vfx_void_mid":       "#b464dc",
      "vfx_void_card_dark": "#7858a0",
      "vfx_void_card_mid":  "#9878c0"
    },
    "semantic": {
      "bg_default":      { "ref": "ocean_deep" },
      "bg_panel":        { "ref": "menu_blue" },
      "bg_elev_cream":   { "ref": "sail_cream" },
      "bg_elev_wood":    { "ref": "hull_wood" },
      "bg_quiet":        { "ref": "dungeon_quiet" },
      "fg_primary":      { "ref": "text_light" },
      "fg_on_cream":     { "ref": "text_dark" },
      "fg_muted":        "#a8a8c0",
      "fg_hint":         "#58587a",
      "border_primary":  { "ref": "menu_border" },
      "border_dark":     { "ref": "text_dark" },
      "accent":          { "ref": "gold_accent" },
      "danger":          { "ref": "flag_red" },
      "hp_full":         "#58c068",
      "hp_low":          { "ref": "flag_red" },
      "hp_you":          "#58c068",
      "hp_vega":         { "ref": "vega_pulse" },
      "hp_mira":         { "ref": "mira_amber" },
      "paid_usdc":       "#58c068",
      "paid_free":       { "ref": "gold_accent" },
      "overlay_scrim":   "rgba(0,0,0,0.6)"
    }
  },

  "typography": {
    "family": "VT323",
    "fallback": "monospace",
    "asset_path": "fonts/VT323-Regular.ttf",
    "license": "OFL 1.1",
    "sizes_px": {
      "xs": 8,
      "sm": 16,
      "md": 24,
      "lg": 32,
      "xl": 48,
      "xxl": 64
    },
    "weights": { "regular": 400 },
    "letter_spacing": {
      "tight":   0.02,
      "default": 0.04,
      "wide":    0.08,
      "loose":   0.12,
      "loosest": 0.2
    },
    "line_height": { "tight": 1.0, "normal": 1.1, "loose": 1.2 },
    "rules": [
      "Only sizes 8/16/24/32/48/64 px. No in-betweens.",
      "No anti-aliasing. PixiJS: set text.resolution = 1, roundPixels = true.",
      "All text snaps to integer pixel positions."
    ]
  },

  "spacing_px": {
    "0": 0,
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32,
    "7": 48,
    "8": 64,
    "rules": [
      "Use the 4/8/12/16/24/32 scale. Avoid odd values.",
      "Padding inside GBA dialog: 12px (spacing.3) vertical, 16px (spacing.4) horizontal.",
      "Gap between HUD items: 12px (spacing.3)."
    ]
  },

  "borders_px": {
    "hairline": 1,
    "standard": 2,
    "double":   4,
    "thick":    6,
    "notes": [
      "GBA dialog = 2px text_dark outer + 2px menu_border inner (double = 4px total).",
      "Dungeon slab frame = 3px text_dark.",
      "HP bar = 1px text_dark outer + 1px inner highlight (rgba white 60%)."
    ]
  },

  "radii_px": {
    "none": 0,
    "rule": "Pixel art has square corners only. NEVER use non-zero radii except for tiny organic shapes like moon or gold padlock shackle."
  },

  "viewport": {
    "logical": { "width": 240, "height": 160 },
    "render_scale": 2,
    "render": { "width": 480, "height": 320 },
    "tile_sizes_px": {
      "overworld":  16,
      "dungeon":    24,
      "card_small": 32,
      "card_large": 48
    }
  },

  "z_layers": {
    "bg_base":      0,
    "tilemap":      1,
    "path":         2,
    "decorations":  3,
    "buildings":    4,
    "fx_under":     5,
    "sprites":      6,
    "fx_over":      7,
    "hud":          10,
    "dialog":       11,
    "modal":        20,
    "banner":       25
  },

  "animations_ms": {
    "cursor_blink":      500,
    "breathe":          3600,
    "sway":             3200,
    "shimmer":          2800,
    "vs_splash_hold":    800,
    "paywall_shatter":   600,
    "chest_crack":       500,
    "banner_slide_in":   300,
    "dialog_reveal":     200,
    "shake_hit":         200
  },

  "component_tokens": {
    "gba_dialog": {
      "fill_ref":     "menu_blue",
      "border_outer": "text_dark",
      "border_inner": "menu_border",
      "border_w":     2,
      "padding":      { "x": 16, "y": 12 },
      "text_ref":     "text_light",
      "text_size":    24
    },
    "location_banner": {
      "fill_ref":     "menu_blue",
      "border_ref":   "menu_border",
      "border_w":     2,
      "padding":      { "x": 16, "y": 4 },
      "text_ref":     "menu_border",
      "text_size":    16
    },
    "hp_bar": {
      "height":       8,
      "pad":          1,
      "outline_ref":  "text_dark",
      "highlight_rgba": "rgba(255,255,255,0.6)",
      "fills": {
        "you":  "hp_you",
        "vega": "hp_vega",
        "mira": "hp_mira",
        "low":  "hp_low"
      }
    },
    "menu_button": {
      "fill_ref":        "sail_cream",
      "border_ref":      "text_dark",
      "inner_accent":    "menu_border",
      "sel_fill":        "flag_red",
      "sel_text":        "menu_border",
      "cursor_glyph":    "►",
      "cursor_color":    "menu_border",
      "padding":         { "x": 12, "y": 4 },
      "text_size":       16
    },
    "hpbox": {
      "fill_ref":     "menu_blue",
      "border_ref":   "menu_border",
      "border_w":     2,
      "padding":      { "x": 8, "y": 4 },
      "min_width":    140,
      "variants": {
        "you":  { "fill": "ocean_deep",  "border": "ocean_shallow", "nm": "ocean_shallow" },
        "vega": { "fill": "vega_deep",   "border": "vega_pulse",    "nm": "vega_pulse" },
        "mira": { "fill": "mira_deep",   "border": "menu_border",   "nm": "menu_border" }
      }
    },
    "card_frame": {
      "art_size":      32,
      "border_outer":  "text_dark",
      "border_inner":  "menu_border",
      "fill_ref":      "sail_cream",
      "no_label_ref":  "hull_wood",
      "nm_label_ref":  "text_dark",
      "rarity_stripe_w": 4
    },
    "chest": {
      "body_ref":      "hull_wood",
      "body_top":      { "ref": "hull_highlight" },
      "body_bot":      { "ref": "hull_shadow" },
      "lock_ref":      "menu_border",
      "border_ref":    "text_dark",
      "size":          { "w": 64, "h": 64 }
    }
  }
}
